# Database Configuration
# Default is in-memory replaceable data access layer with verified demonstration data.
# When Firebase Firestore is provisioned, set DATABASE_TYPE="firestore"
DATABASE_TYPE="memory"

# Local Ollama AI Integration (Qwen3.5-4B / Gwen3.5-4B)
# In local development on your machine, Ollama runs at http://localhost:11434
# In cloud deployment (Google AI Studio / Cloud Run), localhost refers to the cloud container,
# not your personal computer. Set OLLAMA_BASE_URL to your secure tunnel (e.g., ngrok/Tailscale)
# or local IP if deployed on your local network.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_TIMEOUT_MS=8000

# Optional Gemini API Key (Fallback if local Ollama is offline)
GEMINI_API_KEY=""

# Application hosting
PORT=3000
APP_URL="http://localhost:3000"
